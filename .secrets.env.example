# .secrets.env.example — template for `.secrets.env`
#
# Copy this file to `.secrets.env` and replace every placeholder with a real value.
# `.mise.toml` loads `.secrets.env` via `[env] _.file`, and docker-compose reads the
# same variable names. Never commit `.secrets.env` itself (gitleaks blocks it in
# pre-commit). All secrets come from the environment only — never from code.

# --- Session signing -------------------------------------------------------------
# Secret key for the server-side session cookie (HttpOnly session, decision D1).
# Generate a fresh value with: openssl rand -hex 32
#SESSION_SECRET_KEY=<generate: openssl rand -hex 32>

# --- OIDC provider config ---------------------------------------------------------
# Pydantic-settings nested delimiter is `__` (env prefix OIDC__).
# Provider name here is `keycloak`. In dev this points at the mock IdP container
# it is NOT real Keycloak.
#
# COUPLING: OIDC__PROVIDERS__KEYCLOAK__ISSUER MUST equal VITE_OIDC_AUTHORITY in
# .mise.toml (both https://localhost:8443/realms/fmv) so the mock IdP matches the
# frontend authority. Change one, change both.
OIDC__PROVIDERS__KEYCLOAK__ISSUER=https://localhost:8443/realms/fmv
OIDC__PROVIDERS__KEYCLOAK__AUDIENCE=fmv-demo-api
OIDC__PROVIDERS__KEYCLOAK__CLIENT_ID=fmv-web
# Claim that carries roles/scopes; validated against api/scopes.py constants (D3).
OIDC__PROVIDERS__KEYCLOAK__ROLE_CLAIMS=groups
# Dev self-signed mock IdP ONLY (D7: verify_ssl defaults to true; never ship false).
OIDC__PROVIDERS__KEYCLOAK__VERIFY_SSL=false
OIDC__DEFAULT_PROVIDER=keycloak

# Dev/CI stub (D2): inline JWKS JSON, selected by token header `kid` — no network
# call to fetch keys. This is the dev/CI stub and is REJECTED at startup when
# BACKEND_ENVIRONMENT=production (fail closed). Leave commented out for the real
# network path (PyJWKClient fetches from the provider jwks_url).
# Example shape only — replace with the committed test public JWKS fixture contents:
# OIDC__PROVIDERS__KEYCLOAK__STATIC_JWKS='{"keys":[{"kty":"RSA","kid":"<test-kid>","n":"<modulus>","e":"AQAB"}]}'

# --- Environment gate ------------------------------------------------------------
# "dev" allows the static_jwks stub above. Set to "production" to reject it at
# startup. See docs/decisions-log.md (D2).
BACKEND_ENVIRONMENT=dev

# --- CORS --------------------------------------------------------------------------
# Session cookies (D1=a) require credentials=true. Allowed origins stay explicit in
# .mise.toml CORS_ALLOW_ORIGINS — wildcard origins with credentials is invalid CORS.
CORS_ALLOW_CREDENTIALS=true
